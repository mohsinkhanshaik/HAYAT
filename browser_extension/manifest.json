{
  "manifest_version": 3,
  "name": "HAYAT Browser Bridge",
  "version": "1.0.0",
  "description": "Lets the local HAYAT runtime inspect and scroll the active tab after pairing.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "options_page": "options.html",
  "action": {"default_title": "HAYAT Browser Bridge"}
}
