# Copy this file to .env and add only the credentials you choose to use.
# Default ZERO-COST mode ignores cloud credentials even when they are present.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as a compatibility alias when GEMINI_API_KEY is blank.
GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest

LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=

# local, lm_studio, openai, or auto
AI_MODEL_PROVIDER=auto
AI_VISION_PROVIDER=
AI_PROJECT_ROOT=

# Optional web-search provider. With no key, the local provider chain uses
# public HTML search. Brave is used when a key is supplied.
BRAVE_SEARCH_API_KEY=
AI_SEARCH_PROVIDER=auto

# Optional voice overrides. Voice works locally without cloud credentials.
AI_VOICE_STT_MODEL=base.en
AI_VOICE_LANGUAGE=auto

# Optional. When set, leaving the persistent child-safe teaching mode requires
# this PIN. Keep the real value only in .env; it is never committed.
HAYAT_PARENT_PIN=

# Access passphrase for the local web server (main.py --web), so a phone or
# browser on your private mesh can reach HAYAT. Required to start web access;
# make it long. Every remote request runs with reduced REMOTE_OWNER authority.
HAYAT_WEB_TOKEN=
